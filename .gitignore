# ============================================
# EduHamuy Web
# Next.js + React + TypeScript
# ============================================

# Dependencies
node_modules/
jspm_packages/
web_modules/

# Package managers
.npm
.pnpm-store
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn-integrity

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Build artifacts
build/
.next/
out/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing / coverage
coverage/
*.lcov
.nyc_output

# Environment variables
# Never commit real environment files or secrets
.env*
!.env.example

# Caches
.cache/
.parcel-cache/
.temp/

# Optional ESLint / Stylelint caches
.eslintcache
.stylelintcache

# npm pack
*.tgz

# OS files
.DS_Store
Thumbs.db

# macOS / certificates / private keys
*.pem

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Editor / tool testing
.vscode-test

# Temporary files
*.tmp
*.temp
